# Template de producao - copie pra .env.production e preencha com valores reais.
# Diferenca chave em relacao ao .env.example de dev: dominios/URLs sao publicos e
# HTTPS (o Mercado Pago rejeita back_url com localhost mesmo em teste), e alguns
# valores aqui tambem precisam ser passados como build ARG pro container do
# apps/web (ver docker-compose.prod.yml) porque o Vite inlina VITE_* no bundle em
# tempo de build, nao de runtime.

# App
NODE_ENV=production
PORT=3333
# Dominio publico servido pelo Caddy - sem isso o CORS bloqueia o frontend
CORS_ORIGIN=https://seu-dominio.com

# Postgres (container gerenciado pelo docker-compose.prod.yml - nao exponha a
# porta publicamente em producao, o servico "postgres" so precisa ser alcancavel
# pelo "api" dentro da rede interna do compose)
POSTGRES_USER=pomofoca
POSTGRES_PASSWORD=troque_por_uma_senha_forte_gerada
POSTGRES_DB=pomofoca
DATABASE_URL=postgresql://pomofoca:troque_por_uma_senha_forte_gerada@postgres:5432/pomofoca

# Redis (idem - so precisa ser alcancavel dentro da rede do compose)
REDIS_URL=redis://redis:6379

# JWT - gere segredos novos e distintos so pra producao, nunca reaproveite os de dev
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth - GOOGLE_CLIENT_ID precisa ser IDENTICO ao VITE_GOOGLE_CLIENT_ID
# abaixo (mesmo Client ID, um e lido pelo backend pra validar o idToken, o outro
# e inlinado no bundle do frontend pra renderizar o botao oficial do Google).
# No Google Cloud Console, adicione https://seu-dominio.com em "Origens
# JavaScript autorizadas" do Client ID de producao (client separado do de dev,
# que hoje so tem http://localhost:5173 autorizado).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_BACK_URL=https://seu-dominio.com/subscription/callback
PREMIUM_MONTHLY_PRICE=14.90
PREMIUM_YEARLY_PRICE=119.90
PREMIUM_PLAN_CURRENCY=BRL

# Web Push (VAPID) - gere um par PROPRIO de producao com
# `npx web-push generate-vapid-keys` (nao reaproveite o par de dev). Precisa
# estar duplicado com VITE_VAPID_PUBLIC_KEY abaixo (mesma chave publica, so a
# privada fica exclusiva do backend).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# --- Build args do container apps/web (docker-compose.prod.yml le essas duas
# daqui e repassa como --build-arg; nao sao lidas em runtime, so no build) ---
VITE_GOOGLE_CLIENT_ID=
VITE_VAPID_PUBLIC_KEY=

# --- Caddy ---
# Dominio que o Caddyfile usa pra emitir certificado TLS automatico (Let's
# Encrypt) - precisa apontar (DNS) pro IP do servidor antes do primeiro boot.
DOMAIN=seu-dominio.com
