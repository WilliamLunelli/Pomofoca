# App
NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:5173

# Postgres
POSTGRES_USER=pomofoca
POSTGRES_PASSWORD=pomofoca
POSTGRES_DB=pomofoca

# Nota: porta host 5433 (nao 5432) porque em muitas maquinas Windows ja existe um
# Postgres nativo ocupando 5432 no IPv4, o que faz "localhost:5432" cair no servico
# errado mesmo com o container rodando. Ajuste se sua maquina nao tiver esse conflito.
DATABASE_URL=postgresql://pomofoca:pomofoca@localhost:5433/pomofoca

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=changeme_generate_a_random_32_char_secret
JWT_REFRESH_SECRET=changeme_generate_a_different_random_32_char_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# O Mercado Pago REJEITA back_url com localhost (precisa ser uma URL publica/HTTPS,
# mesmo em teste) - use um tunel (ex: ngrok http 5173) ou um placeholder temporario
# enquanto nao tem dominio de producao. Nao deixe como localhost, o checkout falha.
MERCADO_PAGO_BACK_URL=https://example.com/subscription/callback
# Precos do plano Premium: mensal e anual (anual ~33% mais barato por mes, incentivo
# pra reduzir churn e melhorar fluxo de caixa)
PREMIUM_MONTHLY_PRICE=14.90
PREMIUM_YEARLY_PRICE=119.90
PREMIUM_PLAN_CURRENCY=BRL
