# Modo padrão: "cli" usa os CLIs logados na sua assinatura (claude / agy), SEM chave de API.
# AGENT_PROVIDER_MODE=cli
# CLAUDE_CLI_MODEL=sonnet
# AGY_STRONG_MODEL=gemini-3.8-flash-high
# AGY_FAST_MODEL=gemini-3.8-flash-medium
# AGENT_AGY_MAX_RESUMES=3
# AGENT_MODEL_SEGURANCA=claude-cli:opus

# Só para AGENT_PROVIDER_MODE=api. Exporte no seu shell (ou use um gerenciador de segredos). NUNCA commite chaves.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Opcionais — sobrescrevem os defaults de src/config.ts
# CLAUDE_SONNET_MODEL=claude-sonnet-5-5
# GEMINI_PRO_MODEL=gemini-3.1-pro-preview
# GEMINI_FLASH_MODEL=gemini-3.8-flash
# AGENT_MAX_TOKENS_PER_TASK=4000000   (padrão: 4M no modo cli, 600k no modo api)
# AGENT_MAX_DELEGATIONS_PER_TASK=14
# AGENT_WORKER_TIMEOUT_MS=600000
