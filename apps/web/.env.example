# Chave publica VAPID - precisa ser a MESMA do VAPID_PUBLIC_KEY no .env da raiz
# (backend). Gere o par com `npx web-push generate-vapid-keys` na raiz do monorepo.
VITE_VAPID_PUBLIC_KEY=

# Client ID do Google OAuth - precisa ser o MESMO do GOOGLE_CLIENT_ID no .env da
# raiz (backend).
VITE_GOOGLE_CLIENT_ID=
